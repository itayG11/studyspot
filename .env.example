# Copy this file to .env and change the values. Never commit .env.

# PostgreSQL (local development, used by docker-compose.yml)
POSTGRES_USER=studyspot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyspot
POSTGRES_PORT=5432

# Backend connection strings
DATABASE_URL=postgresql+psycopg://studyspot:change-me@localhost:5432/studyspot
# Separate database for pytest. Tests create it if it is missing and wipe it freely.
TEST_DATABASE_URL=postgresql+psycopg://studyspot:change-me@localhost:5432/studyspot_test

# Signs the QR check-in codes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECKIN_CODE_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more

# Signs access tokens and the sign-in cookie. Generate like the code secret.
JWT_SECRET=change-me-to-another-long-random-value-of-32-chars-or-more

# Sign-in providers (see docs/AUTH_SETUP.md). Leave empty to switch one off.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo sign-in: a demo student and a demo institution admin, no Microsoft
# account needed, in the demo campus (app/seed/demo.py). The server refuses
# to use it with an institution that has real sign-in rules, like Braude.
DEMO_LOGIN_ENABLED=false
DEMO_INSTITUTION=demo

# Where the API and the web app run.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
COOKIE_SECURE=true

# Sign-in with a one-time code by email (backend/app/email_codes.py).
# Production: a Brevo API key, and the From address on a domain verified
# at Brevo. Development: EMAIL_LOGIN_DEV_LOG=true prints the codes to the
# server log instead (refused when SITE_URL is set).
BREVO_API_KEY=
EMAIL_SENDER=
EMAIL_LOGIN_DEV_LOG=false

# Who runs the whole service: creates institutions and invites their
# admins. Google addresses, comma-separated; honoured only when Google has
# verified the address. Empty: nobody.
SYSTEM_ADMIN_EMAILS=
