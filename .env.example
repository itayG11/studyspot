# Copy this file to .env and change the values. Never commit .env.

# PostgreSQL (local development, used by docker-compose.yml)
POSTGRES_USER=studyspot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studyspot
POSTGRES_PORT=5432

# Backend connection strings
DATABASE_URL=postgresql+psycopg://studyspot:change-me@localhost:5432/studyspot
# Separate database for pytest. Tests create it if it is missing and wipe it freely.
TEST_DATABASE_URL=postgresql+psycopg://studyspot:change-me@localhost:5432/studyspot_test

# Signs the QR check-in codes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECKIN_CODE_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more

# Signs access tokens and the sign-in cookie. Generate like the code secret.
JWT_SECRET=change-me-to-another-long-random-value-of-32-chars-or-more

# Sign-in providers (see docs/AUTH_SETUP.md). Leave empty to switch one off.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo sign-in: a demo student and a demo institution admin, no Microsoft
# account needed. For development and the live demo only. Keep it false
# anywhere real students sign in.
DEMO_LOGIN_ENABLED=false
DEMO_INSTITUTION=braude

# Where the API and the web app run.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
COOKIE_SECURE=true
