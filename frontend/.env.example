# Copy to .env.local (git-ignored). Vite exposes only variables that start
# with VITE_ to the site, and everything here ends up public in the browser:
# never put a secret in this file.
VITE_API_URL=http://localhost:8000
VITE_INSTITUTION=demo
# The public address printed inside the signs' QR codes (no trailing slash).
VITE_SITE_URL=http://localhost:5173
# The aerial photo layer (Esri). On in development; a public build needs an
# ArcGIS account under Esri's terms first (docs/DEPLOY.md). on | off
VITE_AERIAL=on
